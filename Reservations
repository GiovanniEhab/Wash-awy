<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Washawy | Reservations</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
  <header>
    <h1>Reservations</h1>
    <nav>
      <a href="#Home">Home</a>
      <a href="#Services">Services</a>
      <a href="#Offers">Offers</a>
      <a href="#About">About</a>
    </nav>
  </header>

  <main>
    <section id="outshop-cleaning">
      <h2>OutShop Cleaning</h2>
      <p>Reserve A Home Delivery Cleaning.</p>
      
      <form>
        <div class="form-group">
            <label for="first-name">First Name</label>
            <input type="text" id="first-name" placeholder="e.g. Giovanni" maxlength="14" required>
        </div>

        <div class="form-group">
            <label for="last-name">Last Name</label>
            <input type="text" id="last-name" placeholder="e.g. Ehab" maxlength="14"required>
        </div>

        <div class="form-group">
            <label for="email">Email</label>
            <input type="email" id="email" placeholder="e.g. Gxxxxxxx6@gmail.com" required>
        </div>

        <div class="form-group">
            <label for="phone">Phone</label>
            <input type="tel" id="phone" placeholder="01xxxxxxxxx" pattern="01[0125][0-9]{8}" maxlength="11" required>
        </div>

        <div class="submit-box">
             <p>Ready to go? Click below to confirm your reservation.</p>
             <button type="submit" class="submit-btn">Confirm Reservation</button>
            </div>

        <fieldset>
            <legend>Which Service You Desire!</legend>
            <label><input type="radio" name="OutShop"> Chemical Cleaning</label><br>
            <label><input type="radio" name="OutShop"> Standard Cleaning</label>
        </fieldset>
      </form>
    </section>

    <section id="inshop-cleaning">
      <h2>InShop Cleaning</h2>
      <p>Reserve An InShop Cleaning.</p>
      <form>
        <label><input type="radio" name="InShop"> Chemical Cleaning</label><br>
        <label><input type="radio" name="InShop"> Standard In & Out</label><br>
        <label><input type="radio" name="InShop"> Interior Cleaning</label><br>
        <label><input type="radio" name="InShop"> Exterior Cleaning</label><br>
        
        <p>
            Choose A Day! <input type="date"> 
            And Time! <input type="time">
            <div id="confirmation-box-inshop">
      <p>By clicking confirm, you agree to show up at the selected time.</p>
      <button type="submit">Confirm InShop Reservation</button>
    </div>
        </p>
        
      </form>
    </section>
  </main>

  <footer>
    <div id="footer-content">
        <div id="footer-about">
            <h2>Wash-awy</h2>
            <p>Egypt's premier car care destination. We combine advanced technology with traditional craftsmanship.</p>
        </div>

        <div id="footer-links">
            <h3>Quick Links</h3>
            <a href="homepage.html">Home</a><br>
            <a href="services.html">Our Services</a><br>
            <a href="about.html">About</a><br>
            <a href="contact.html">Contact</a>
        </div>

        <div id="footer-social">
            <h3>Follow Us</h3>
            <a href="https://facebook.com/washawy" target="_blank">Facebook</a><br>
            <a href="https://instagram.com/washawy" target="_blank">Instagram</a>
        </div>
    </div>
    <p class="rights">© 2024 Wash-awy. All rights reserved.</p>
  </footer>
</body>
</html>
